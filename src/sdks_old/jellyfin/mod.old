    ///Gets the search hint result
    ///
    ///Sends a `GET` request to `/Search/Hints`
    ///
    ///Arguments:
    /// - `exclude_item_types`: If specified, results with these item types are
    ///   filtered out. This allows multiple, comma delimited.
    /// - `include_artists`: Optional filter whether to include artists.
    /// - `include_genres`: Optional filter whether to include genres.
    /// - `include_item_types`: If specified, only results with the specified
    ///   item types are returned. This allows multiple, comma delimited.
    /// - `include_media`: Optional filter whether to include media.
    /// - `include_people`: Optional filter whether to include people.
    /// - `include_studios`: Optional filter whether to include studios.
    /// - `is_kids`: Optional filter for kids.
    /// - `is_movie`: Optional filter for movies.
    /// - `is_news`: Optional filter for news.
    /// - `is_series`: Optional filter for series.
    /// - `is_sports`: Optional filter for sports.
    /// - `limit`: Optional. The maximum number of records to return.
    /// - `media_types`: If specified, only results with the specified media
    ///   types are returned. This allows multiple, comma delimited.
    /// - `parent_id`: If specified, only children of the parent are returned.
    /// - `search_term`: The search term to filter on.
    /// - `start_index`: Optional. The record index to start at. All items with
    ///   a lower index will be dropped from the results.
    /// - `user_id`: Optional. Supply a user id to search within a user's
    ///   library or omit to search all.
    ///```ignore
    /// let response = client.get_search_hints()
    ///    .exclude_item_types(exclude_item_types)
    ///    .include_artists(include_artists)
    ///    .include_genres(include_genres)
    ///    .include_item_types(include_item_types)
    ///    .include_media(include_media)
    ///    .include_people(include_people)
    ///    .include_studios(include_studios)
    ///    .is_kids(is_kids)
    ///    .is_movie(is_movie)
    ///    .is_news(is_news)
    ///    .is_series(is_series)
    ///    .is_sports(is_sports)
    ///    .limit(limit)
    ///    .media_types(media_types)
    ///    .parent_id(parent_id)
    ///    .search_term(search_term)
    ///    .start_index(start_index)
    ///    .user_id(user_id)
    ///    .send()
    ///    .await;
    /// ```
    pub fn get_search_hints(&self) -> builder::GetSearchHints {
        builder::GetSearchHints::new(self)
    }

