    ///    .start_item_id(start_item_id)
    ///    .user_id(user_id)
    ///    .send()
    ///    .await;
    /// ```
    pub fn get_episodes(&self) -> builder::GetEpisodes {
        builder::GetEpisodes::new(self)
    }

