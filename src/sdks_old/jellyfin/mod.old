        ///Sends a `HEAD` request to `/Videos/{itemId}/stream.{container}`
        pub async fn send(self) -> Result<ResponseValue<ByteStream>, Error<()>> {
            let Self {
                client,
                item_id,
                container,
                allow_audio_stream_copy,
                allow_video_stream_copy,
                audio_bit_rate,
                audio_channels,
                audio_codec,
                audio_sample_rate,
                audio_stream_index,
                break_on_non_key_frames,
                context,
                copy_timestamps,
                cpu_core_limit,
                de_interlace,
                device_id,
                device_profile_id,
                enable_audio_vbr_encoding,
                enable_auto_stream_copy,
                enable_mpegts_m2_ts_mode,
                framerate,
                height,
                level,
                live_stream_id,
                max_audio_bit_depth,
                max_audio_channels,
                max_framerate,
                max_height,
                max_ref_frames,
                max_video_bit_depth,
                max_width,
                media_source_id,
                min_segments,
                params,
                play_session_id,
                profile,
                require_avc,
                require_non_anamorphic,
                segment_container,
                segment_length,
                start_time_ticks,
                static_,
                stream_options,
                subtitle_codec,
                subtitle_method,
                subtitle_stream_index,
                tag,
                transcode_reasons,
                transcoding_max_audio_channels,
                video_bit_rate,
                video_codec,
                video_stream_index,
                width,
            } = self;
            let item_id = item_id.map_err(Error::InvalidRequest)?;
            let container = container.map_err(Error::InvalidRequest)?;
            let allow_audio_stream_copy =
                allow_audio_stream_copy.map_err(Error::InvalidRequest)?;
            let allow_video_stream_copy =
                allow_video_stream_copy.map_err(Error::InvalidRequest)?;
            let audio_bit_rate = audio_bit_rate.map_err(Error::InvalidRequest)?;
            let audio_channels = audio_channels.map_err(Error::InvalidRequest)?;
            let audio_codec = audio_codec.map_err(Error::InvalidRequest)?;
            let audio_sample_rate = audio_sample_rate.map_err(Error::InvalidRequest)?;
            let audio_stream_index =
                audio_stream_index.map_err(Error::InvalidRequest)?;
            let break_on_non_key_frames =
                break_on_non_key_frames.map_err(Error::InvalidRequest)?;
            let context = context.map_err(Error::InvalidRequest)?;
            let copy_timestamps = copy_timestamps.map_err(Error::InvalidRequest)?;
            let cpu_core_limit = cpu_core_limit.map_err(Error::InvalidRequest)?;
            let de_interlace = de_interlace.map_err(Error::InvalidRequest)?;
            let device_id = device_id.map_err(Error::InvalidRequest)?;
            let device_profile_id = device_profile_id.map_err(Error::InvalidRequest)?;
            let enable_audio_vbr_encoding =
                enable_audio_vbr_encoding.map_err(Error::InvalidRequest)?;
            let enable_auto_stream_copy =
                enable_auto_stream_copy.map_err(Error::InvalidRequest)?;
            let enable_mpegts_m2_ts_mode =
                enable_mpegts_m2_ts_mode.map_err(Error::InvalidRequest)?;
            let framerate = framerate.map_err(Error::InvalidRequest)?;
            let height = height.map_err(Error::InvalidRequest)?;
            let level = level.map_err(Error::InvalidRequest)?;
            let live_stream_id = live_stream_id.map_err(Error::InvalidRequest)?;
            let max_audio_bit_depth =
                max_audio_bit_depth.map_err(Error::InvalidRequest)?;
            let max_audio_channels =
                max_audio_channels.map_err(Error::InvalidRequest)?;
            let max_framerate = max_framerate.map_err(Error::InvalidRequest)?;
            let max_height = max_height.map_err(Error::InvalidRequest)?;
            let max_ref_frames = max_ref_frames.map_err(Error::InvalidRequest)?;
            let max_video_bit_depth =
                max_video_bit_depth.map_err(Error::InvalidRequest)?;
            let max_width = max_width.map_err(Error::InvalidRequest)?;
            let media_source_id = media_source_id.map_err(Error::InvalidRequest)?;
            let min_segments = min_segments.map_err(Error::InvalidRequest)?;
            let params = params.map_err(Error::InvalidRequest)?;
            let play_session_id = play_session_id.map_err(Error::InvalidRequest)?;
            let profile = profile.map_err(Error::InvalidRequest)?;
            let require_avc = require_avc.map_err(Error::InvalidRequest)?;
            let require_non_anamorphic =
                require_non_anamorphic.map_err(Error::InvalidRequest)?;
            let segment_container = segment_container.map_err(Error::InvalidRequest)?;
            let segment_length = segment_length.map_err(Error::InvalidRequest)?;
            let start_time_ticks = start_time_ticks.map_err(Error::InvalidRequest)?;
            let static_ = static_.map_err(Error::InvalidRequest)?;
            let stream_options = stream_options.map_err(Error::InvalidRequest)?;
            let subtitle_codec = subtitle_codec.map_err(Error::InvalidRequest)?;
            let subtitle_method = subtitle_method.map_err(Error::InvalidRequest)?;
            let subtitle_stream_index =
                subtitle_stream_index.map_err(Error::InvalidRequest)?;
            let tag = tag.map_err(Error::InvalidRequest)?;
            let transcode_reasons = transcode_reasons.map_err(Error::InvalidRequest)?;
            let transcoding_max_audio_channels =
                transcoding_max_audio_channels.map_err(Error::InvalidRequest)?;
            let video_bit_rate = video_bit_rate.map_err(Error::InvalidRequest)?;
            let video_codec = video_codec.map_err(Error::InvalidRequest)?;
            let video_stream_index =
                video_stream_index.map_err(Error::InvalidRequest)?;
            let width = width.map_err(Error::InvalidRequest)?;
            let url = format!(
                "{}/Videos/{}/stream.{}",
                client.baseurl,
                encode_path(&item_id.to_string()),
                encode_path(&container.to_string()),
            );
            #[allow(unused_mut)]
            let mut request = client
                .client
                .head(url)
                .query(&progenitor_client::QueryParam::new(
                    "allowAudioStreamCopy",
                    &allow_audio_stream_copy,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "allowVideoStreamCopy",
                    &allow_video_stream_copy,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "audioBitRate",
                    &audio_bit_rate,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "audioChannels",
                    &audio_channels,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "audioCodec",
