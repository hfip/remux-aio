    ///    .format(format)
    ///    .height(height)
    ///    .max_height(max_height)
    ///    .max_width(max_width)
    ///    .percent_played(percent_played)
    ///    .quality(quality)
    ///    .tag(tag)
    ///    .unplayed_count(unplayed_count)
    ///    .width(width)
    ///    .send()
    ///    .await;
    /// ```
    pub fn get_artist_image(&self) -> builder::GetArtistImage {
