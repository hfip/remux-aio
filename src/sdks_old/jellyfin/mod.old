    ///    .limit(limit)
    ///    .media_types(media_types)
    ///    .parent_id(parent_id)
    ///    .recursive(recursive)
    ///    .sort_by(sort_by)
    ///    .sort_order(sort_order)
    ///    .start_index(start_index)
    ///    .user_id(user_id)
    ///    .send()
    ///    .await;
    /// ```
    pub fn get_years(&self) -> builder::GetYears {
