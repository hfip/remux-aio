        builder::RefreshItem::new(self)
    }

    ///Gets items based on a query
    ///
    ///Sends a `GET` request to `/Items`
    ///
    ///Arguments:
    /// - `adjacent_to`: Optional. Return items that are siblings of a supplied
    ///   item.
    /// - `album_artist_ids`: Optional. If specified, results will be filtered
    ///   to include only those containing the specified album artist id.
    /// - `album_ids`: Optional. If specified, results will be filtered based on
    ///   album id. This allows multiple, pipe delimited.
    /// - `albums`: Optional. If specified, results will be filtered based on
    ///   album. This allows multiple, pipe delimited.
    /// - `artist_ids`: Optional. If specified, results will be filtered to
    ///   include only those containing the specified artist id.
    /// - `artists`: Optional. If specified, results will be filtered based on
    ///   artists. This allows multiple, pipe delimited.
    /// - `collapse_box_set_items`: Whether or not to hide items behind their
    ///   boxsets.
    /// - `contributing_artist_ids`: Optional. If specified, results will be
    ///   filtered to include only those containing the specified contributing
    ///   artist id.
    /// - `enable_image_types`: Optional. The image types to include in the
    ///   output.
    /// - `enable_images`: Optional, include image information in output.
    /// - `enable_total_record_count`: Optional. Enable the total record count.
    /// - `enable_user_data`: Optional, include user data.
    /// - `exclude_artist_ids`: Optional. If specified, results will be filtered
    ///   based on artist id. This allows multiple, pipe delimited.
    /// - `exclude_item_ids`: Optional. If specified, results will be filtered
    ///   by excluding item ids. This allows multiple, comma delimited.
    /// - `exclude_item_types`: Optional. If specified, results will be filtered
    ///   based on item type. This allows multiple, comma delimited.
    /// - `exclude_location_types`: Optional. If specified, results will be
    ///   filtered based on the LocationType. This allows multiple, comma
    ///   delimited.
    /// - `fields`: Optional. Specify additional fields of information to return
    ///   in the output. This allows multiple, comma delimited. Options: Budget,
    ///   Chapters, DateCreated, Genres, HomePageUrl, IndexOptions,
    ///   MediaStreams, Overview, ParentId, Path, People, ProviderIds,
    ///   PrimaryImageAspectRatio, Revenue, SortName, Studios, Taglines.
    /// - `filters`: Optional. Specify additional filters to apply. This allows
    ///   multiple, comma delimited. Options: IsFolder, IsNotFolder, IsUnplayed,
    ///   IsPlayed, IsFavorite, IsResumable, Likes, Dislikes.
    /// - `genre_ids`: Optional. If specified, results will be filtered based on
    ///   genre id. This allows multiple, pipe delimited.
    /// - `genres`: Optional. If specified, results will be filtered based on
    ///   genre. This allows multiple, pipe delimited.
    /// - `has_imdb_id`: Optional filter by items that have an IMDb id or not.
    /// - `has_official_rating`: Optional filter by items that have official
    ///   ratings.
    /// - `has_overview`: Optional filter by items that have an overview or not.
    /// - `has_parental_rating`: Optional filter by items that have or do not
    ///   have a parental rating.
    /// - `has_special_feature`: Optional filter by items with special features.
    /// - `has_subtitles`: Optional filter by items with subtitles.
    /// - `has_theme_song`: Optional filter by items with theme songs.
    /// - `has_theme_video`: Optional filter by items with theme videos.
    /// - `has_tmdb_id`: Optional filter by items that have a TMDb id or not.
    /// - `has_trailer`: Optional filter by items with trailers.
    /// - `has_tvdb_id`: Optional filter by items that have a TVDb id or not.
    /// - `ids`: Optional. If specific items are needed, specify a list of item
    ///   id's to retrieve. This allows multiple, comma delimited.
    /// - `image_type_limit`: Optional, the max number of images to return, per
    ///   image type.
    /// - `image_types`: Optional. If specified, results will be filtered based
    ///   on those containing image types. This allows multiple, comma
    ///   delimited.
    /// - `include_item_types`: Optional. If specified, results will be filtered
    ///   based on the item type. This allows multiple, comma delimited.
    /// - `index_number`: Optional filter by index number.
    /// - `is3_d`: Optional filter by items that are 3D, or not.
    /// - `is4_k`: Optional filter by items that are 4K or not.
    /// - `is_favorite`: Optional filter by items that are marked as favorite,
    ///   or not.
    /// - `is_hd`: Optional filter by items that are HD or not.
    /// - `is_kids`: Optional filter for live tv kids.
    /// - `is_locked`: Optional filter by items that are locked.
    /// - `is_missing`: Optional filter by items that are missing episodes or
    ///   not.
    /// - `is_movie`: Optional filter for live tv movies.
    /// - `is_news`: Optional filter for live tv news.
    /// - `is_place_holder`: Optional filter by items that are placeholders.
    /// - `is_played`: Optional filter by items that are played, or not.
    /// - `is_series`: Optional filter for live tv series.
    /// - `is_sports`: Optional filter for live tv sports.
    /// - `is_unaired`: Optional filter by items that are unaired episodes or
    ///   not.
    /// - `limit`: Optional. The maximum number of records to return.
    /// - `location_types`: Optional. If specified, results will be filtered
    ///   based on LocationType. This allows multiple, comma delimited.
    /// - `max_height`: Optional. Filter by the maximum height of the item.
    /// - `max_official_rating`: Optional filter by maximum official rating (PG,
    ///   PG-13, TV-MA, etc).
    /// - `max_premiere_date`: Optional. The maximum premiere date. Format =
    ///   ISO.
    /// - `max_width`: Optional. Filter by the maximum width of the item.
    /// - `media_types`: Optional filter by MediaType. Allows multiple, comma
    ///   delimited.
    /// - `min_community_rating`: Optional filter by minimum community rating.
    /// - `min_critic_rating`: Optional filter by minimum critic rating.
    /// - `min_date_last_saved`: Optional. The minimum last saved date. Format =
    ///   ISO.
    /// - `min_date_last_saved_for_user`: Optional. The minimum last saved date
    ///   for the current user. Format = ISO.
    /// - `min_height`: Optional. Filter by the minimum height of the item.
    /// - `min_official_rating`: Optional filter by minimum official rating (PG,
    ///   PG-13, TV-MA, etc).
    /// - `min_premiere_date`: Optional. The minimum premiere date. Format =
    ///   ISO.
    /// - `min_width`: Optional. Filter by the minimum width of the item.
    /// - `name_less_than`: Optional filter by items whose name is equally or
    ///   lesser than a given input string.
    /// - `name_starts_with`: Optional filter by items whose name is sorted
    ///   equally than a given input string.
    /// - `name_starts_with_or_greater`: Optional filter by items whose name is
    ///   sorted equally or greater than a given input string.
    /// - `official_ratings`: Optional. If specified, results will be filtered
    ///   based on OfficialRating. This allows multiple, pipe delimited.
    /// - `parent_id`: Specify this to localize the search to a specific item or
    ///   folder. Omit to use the root.
    /// - `parent_index_number`: Optional filter by parent index number.
    /// - `person`: Optional. If specified, results will be filtered to include
    ///   only those containing the specified person.
    /// - `person_ids`: Optional. If specified, results will be filtered to
    ///   include only those containing the specified person id.
    /// - `person_types`: Optional. If specified, along with Person, results
    ///   will be filtered to include only those containing the specified person
    ///   and PersonType. Allows multiple, comma-delimited.
    /// - `recursive`: When searching within folders, this determines whether or
    ///   not the search will be recursive. true/false.
    /// - `search_term`: Optional. Filter based on a search term.
    /// - `series_status`: Optional filter by Series Status. Allows multiple,
    ///   comma delimited.
    /// - `sort_by`: Optional. Specify one or more sort orders, comma delimited.
    ///   Options: Album, AlbumArtist, Artist, Budget, CommunityRating,
    ///   CriticRating, DateCreated, DatePlayed, PlayCount, PremiereDate,
    ///   ProductionYear, SortName, Random, Revenue, Runtime.
    /// - `sort_order`: Sort Order - Ascending, Descending.
    /// - `start_index`: Optional. The record index to start at. All items with
    ///   a lower index will be dropped from the results.
    /// - `studio_ids`: Optional. If specified, results will be filtered based
    ///   on studio id. This allows multiple, pipe delimited.
    /// - `studios`: Optional. If specified, results will be filtered based on
    ///   studio. This allows multiple, pipe delimited.
    /// - `tags`: Optional. If specified, results will be filtered based on tag.
    ///   This allows multiple, pipe delimited.
    /// - `user_id`: The user id supplied as query parameter; this is required
    ///   when not using an API key.
    /// - `video_types`: Optional filter by VideoType (videofile, dvd, bluray,
    ///   iso). Allows multiple, comma delimited.
    /// - `years`: Optional. If specified, results will be filtered based on
    ///   production year. This allows multiple, comma delimited.
    ///```ignore
    /// let response = client.get_items()
    ///    .adjacent_to(adjacent_to)
    ///    .album_artist_ids(album_artist_ids)
    ///    .album_ids(album_ids)
    ///    .albums(albums)
    ///    .artist_ids(artist_ids)
    ///    .artists(artists)
    ///    .collapse_box_set_items(collapse_box_set_items)
    ///    .contributing_artist_ids(contributing_artist_ids)
    ///    .enable_image_types(enable_image_types)
    ///    .enable_images(enable_images)
    ///    .enable_total_record_count(enable_total_record_count)
    ///    .enable_user_data(enable_user_data)
    ///    .exclude_artist_ids(exclude_artist_ids)
    ///    .exclude_item_ids(exclude_item_ids)
    ///    .exclude_item_types(exclude_item_types)
    ///    .exclude_location_types(exclude_location_types)
    ///    .fields(fields)
    ///    .filters(filters)
    ///    .genre_ids(genre_ids)
    ///    .genres(genres)
    ///    .has_imdb_id(has_imdb_id)
    ///    .has_official_rating(has_official_rating)
    ///    .has_overview(has_overview)
    ///    .has_parental_rating(has_parental_rating)
    ///    .has_special_feature(has_special_feature)
    ///    .has_subtitles(has_subtitles)
    ///    .has_theme_song(has_theme_song)
    ///    .has_theme_video(has_theme_video)
    ///    .has_tmdb_id(has_tmdb_id)
    ///    .has_trailer(has_trailer)
    ///    .has_tvdb_id(has_tvdb_id)
    ///    .ids(ids)
    ///    .image_type_limit(image_type_limit)
    ///    .image_types(image_types)
    ///    .include_item_types(include_item_types)
    ///    .index_number(index_number)
    ///    .is3_d(is3_d)
    ///    .is4_k(is4_k)
    ///    .is_favorite(is_favorite)
    ///    .is_hd(is_hd)
    ///    .is_kids(is_kids)
    ///    .is_locked(is_locked)
    ///    .is_missing(is_missing)
    ///    .is_movie(is_movie)
    ///    .is_news(is_news)
    ///    .is_place_holder(is_place_holder)
    ///    .is_played(is_played)
    ///    .is_series(is_series)
    ///    .is_sports(is_sports)
    ///    .is_unaired(is_unaired)
    ///    .limit(limit)
    ///    .location_types(location_types)
    ///    .max_height(max_height)
    ///    .max_official_rating(max_official_rating)
    ///    .max_premiere_date(max_premiere_date)
    ///    .max_width(max_width)
    ///    .media_types(media_types)
    ///    .min_community_rating(min_community_rating)
    ///    .min_critic_rating(min_critic_rating)
    ///    .min_date_last_saved(min_date_last_saved)
    ///    .min_date_last_saved_for_user(min_date_last_saved_for_user)
    ///    .min_height(min_height)
    ///    .min_official_rating(min_official_rating)
    ///    .min_premiere_date(min_premiere_date)
    ///    .min_width(min_width)
    ///    .name_less_than(name_less_than)
    ///    .name_starts_with(name_starts_with)
    ///    .name_starts_with_or_greater(name_starts_with_or_greater)
    ///    .official_ratings(official_ratings)
    ///    .parent_id(parent_id)
    ///    .parent_index_number(parent_index_number)
    ///    .person(person)
    ///    .person_ids(person_ids)
    ///    .person_types(person_types)
    ///    .recursive(recursive)
    ///    .search_term(search_term)
    ///    .series_status(series_status)
    ///    .sort_by(sort_by)
    ///    .sort_order(sort_order)
    ///    .start_index(start_index)
    ///    .studio_ids(studio_ids)
    ///    .studios(studios)
    ///    .tags(tags)
    ///    .user_id(user_id)
    ///    .video_types(video_types)
    ///    .years(years)
    ///    .send()
    ///    .await;
    /// ```
    pub fn get_items(&self) -> builder::GetItems {
        builder::GetItems::new(self)
    }

