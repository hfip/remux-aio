    ///    .id(id)
    ///    .image_type_limit(image_type_limit)
    ///    .limit(limit)
    ///    .user_id(user_id)
    ///    .send()
    ///    .await;
    /// ```
    pub fn get_instant_mix_from_music_genre_by_id(
