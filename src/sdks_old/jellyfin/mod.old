        ///Sends a `POST` request to `/Items/{itemId}/Refresh`
        pub async fn send(self) -> Result<ResponseValue<()>, Error<()>> {
            let Self {
                client,
                item_id,
                image_refresh_mode,
                metadata_refresh_mode,
                regenerate_trickplay,
                replace_all_images,
                replace_all_metadata,
            } = self;
            let item_id = item_id.map_err(Error::InvalidRequest)?;
            let image_refresh_mode =
                image_refresh_mode.map_err(Error::InvalidRequest)?;
            let metadata_refresh_mode =
                metadata_refresh_mode.map_err(Error::InvalidRequest)?;
            let regenerate_trickplay =
                regenerate_trickplay.map_err(Error::InvalidRequest)?;
            let replace_all_images =
                replace_all_images.map_err(Error::InvalidRequest)?;
            let replace_all_metadata =
                replace_all_metadata.map_err(Error::InvalidRequest)?;
            let url = format!(
                "{}/Items/{}/Refresh",
                client.baseurl,
                encode_path(&item_id.to_string()),
            );
            #[allow(unused_mut)]
            let mut request = client
                .client
                .post(url)
                .query(&progenitor_client::QueryParam::new(
                    "imageRefreshMode",
                    &image_refresh_mode,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "metadataRefreshMode",
                    &metadata_refresh_mode,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "regenerateTrickplay",
                    &regenerate_trickplay,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "replaceAllImages",
                    &replace_all_images,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "replaceAllMetadata",
                    &replace_all_metadata,
                ))
                .build()?;
            let result = client.client.execute(request).await;
            let response = result?;
            match response.status().as_u16() {
                204u16 => Ok(ResponseValue::empty(response)),
                _ => Err(Error::UnexpectedResponse(response)),
            }
        }
    }

