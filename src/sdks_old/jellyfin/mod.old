    /// - `device_profile_id`: Optional. The dlna device profile id to utilize.
    /// - `enable_audio_vbr_encoding`: Optional. Whether to enable Audio
    ///   Encoding.
    /// - `enable_auto_stream_copy`: Whether or not to allow automatic stream
    ///   copy if requested values match the original source. Defaults to true.
    /// - `enable_mpegts_m2_ts_mode`: Optional. Whether to enable the MpegtsM2Ts
    ///   mode.
    /// - `framerate`: Optional. A specific video framerate to encode to, e.g.
    ///   23.976. Generally this should be omitted unless the device has
    ///   specific requirements.
    /// - `height`: Optional. The fixed vertical resolution of the encoded
    ///   video.
    /// - `level`: Optional. Specify a level for the encoder profile (varies by
    ///   encoder), e.g. 3, 3.1.
    /// - `live_stream_id`: The live stream id.
    /// - `max_audio_bit_depth`: Optional. The maximum audio bit depth.
    /// - `max_audio_channels`: Optional. Specify a maximum number of audio
    ///   channels to encode to, e.g. 2.
    /// - `max_framerate`: Optional. A specific maximum video framerate to
    ///   encode to, e.g. 23.976. Generally this should be omitted unless the
    ///   device has specific requirements.
    /// - `max_ref_frames`: Optional.
    /// - `max_video_bit_depth`: Optional. The maximum video bit depth.
    /// - `media_source_id`: The media version id, if playing an alternate
    ///   version.
    /// - `min_segments`: The minimum number of segments.
    /// - `params`: The streaming parameters.
    /// - `play_session_id`: The play session id.
    /// - `profile`: Optional. Specify a specific an encoder profile (varies by
    ///   encoder), e.g. main, baseline, high.
    /// - `require_avc`: Optional. Whether to require avc.
    /// - `require_non_anamorphic`: Optional. Whether to require a non
    ///   anamporphic stream.
    /// - `segment_container`: The segment container.
    /// - `segment_length`: The segment length.
    /// - `start_time_ticks`: Optional. Specify a starting offset, in ticks. 1
    ///   tick = 10000 ms.
    /// - `static_`: Optional. If true, the original file will be streamed
    ///   statically without any encoding. Use either no url extension or the
    ///   original file extension. true/false.
    /// - `stream_options`: Optional. The streaming options.
    /// - `subtitle_codec`: Optional. Specify a subtitle codec to encode to.
    /// - `subtitle_method`: Optional. Specify the subtitle delivery method.
    /// - `subtitle_stream_index`: Optional. The index of the subtitle stream to
    ///   use. If omitted no subtitles will be used.
    /// - `tag`: The tag.
    /// - `transcode_reasons`: Optional. The transcoding reason.
    /// - `transcoding_max_audio_channels`: Optional. The maximum number of
    ///   audio channels to transcode.
    /// - `video_bit_rate`: Optional. Specify a video bitrate to encode to, e.g.
    ///   500000. If omitted this will be left to encoder defaults.
    /// - `video_codec`: Optional. Specify a video codec to encode to, e.g.
    ///   h264. If omitted the server will auto-select using the url's
    ///   extension.
    /// - `video_stream_index`: Optional. The index of the video stream to use.
    ///   If omitted the first video stream will be used.
    /// - `width`: Optional. The fixed horizontal resolution of the encoded
    ///   video.
    ///```ignore
    /// let response = client.head_audio_stream_by_container()
    ///    .item_id(item_id)
    ///    .container(container)
    ///    .allow_audio_stream_copy(allow_audio_stream_copy)
    ///    .allow_video_stream_copy(allow_video_stream_copy)
    ///    .audio_bit_rate(audio_bit_rate)
    ///    .audio_channels(audio_channels)
    ///    .audio_codec(audio_codec)
    ///    .audio_sample_rate(audio_sample_rate)
    ///    .audio_stream_index(audio_stream_index)
    ///    .break_on_non_key_frames(break_on_non_key_frames)
    ///    .context(context)
    ///    .copy_timestamps(copy_timestamps)
    ///    .cpu_core_limit(cpu_core_limit)
    ///    .de_interlace(de_interlace)
    ///    .device_id(device_id)
    ///    .device_profile_id(device_profile_id)
    ///    .enable_audio_vbr_encoding(enable_audio_vbr_encoding)
    ///    .enable_auto_stream_copy(enable_auto_stream_copy)
    ///    .enable_mpegts_m2_ts_mode(enable_mpegts_m2_ts_mode)
    ///    .framerate(framerate)
    ///    .height(height)
    ///    .level(level)
    ///    .live_stream_id(live_stream_id)
    ///    .max_audio_bit_depth(max_audio_bit_depth)
    ///    .max_audio_channels(max_audio_channels)
    ///    .max_framerate(max_framerate)
    ///    .max_ref_frames(max_ref_frames)
    ///    .max_video_bit_depth(max_video_bit_depth)
    ///    .media_source_id(media_source_id)
    ///    .min_segments(min_segments)
    ///    .params(params)
    ///    .play_session_id(play_session_id)
    ///    .profile(profile)
    ///    .require_avc(require_avc)
    ///    .require_non_anamorphic(require_non_anamorphic)
    ///    .segment_container(segment_container)
    ///    .segment_length(segment_length)
    ///    .start_time_ticks(start_time_ticks)
    ///    .static_(static_)
    ///    .stream_options(stream_options)
    ///    .subtitle_codec(subtitle_codec)
    ///    .subtitle_method(subtitle_method)
    ///    .subtitle_stream_index(subtitle_stream_index)
    ///    .tag(tag)
    ///    .transcode_reasons(transcode_reasons)
    ///    .transcoding_max_audio_channels(transcoding_max_audio_channels)
    ///    .video_bit_rate(video_bit_rate)
    ///    .video_codec(video_codec)
    ///    .video_stream_index(video_stream_index)
    ///    .width(width)
    ///    .send()
    ///    .await;
    /// ```
    pub fn head_audio_stream_by_container(
        &self,
    ) -> builder::HeadAudioStreamByContainer {
        builder::HeadAudioStreamByContainer::new(self)
    }

