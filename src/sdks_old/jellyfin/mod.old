            let height = height.map_err(Error::InvalidRequest)?;
            let image_index = image_index.map_err(Error::InvalidRequest)?;
            let max_height = max_height.map_err(Error::InvalidRequest)?;
            let max_width = max_width.map_err(Error::InvalidRequest)?;
            let percent_played = percent_played.map_err(Error::InvalidRequest)?;
            let quality = quality.map_err(Error::InvalidRequest)?;
            let tag = tag.map_err(Error::InvalidRequest)?;
            let unplayed_count = unplayed_count.map_err(Error::InvalidRequest)?;
            let width = width.map_err(Error::InvalidRequest)?;
            let url = format!(
                "{}/Studios/{}/Images/{}",
                client.baseurl,
                encode_path(&name.to_string()),
                encode_path(&image_type.to_string()),
            );
            #[allow(unused_mut)]
            let mut request = client
                .client
                .get(url)
                .query(&progenitor_client::QueryParam::new(
                    "backgroundColor",
                    &background_color,
                ))
                .query(&progenitor_client::QueryParam::new("blur", &blur))
                .query(&progenitor_client::QueryParam::new(
                    "fillHeight",
                    &fill_height,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "fillWidth",
                    &fill_width,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "foregroundLayer",
                    &foreground_layer,
                ))
                .query(&progenitor_client::QueryParam::new("format", &format))
                .query(&progenitor_client::QueryParam::new("height", &height))
                .query(&progenitor_client::QueryParam::new(
                    "imageIndex",
                    &image_index,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "maxHeight",
                    &max_height,
                ))
                .query(&progenitor_client::QueryParam::new("maxWidth", &max_width))
                .query(&progenitor_client::QueryParam::new(
                    "percentPlayed",
                    &percent_played,
                ))
                .query(&progenitor_client::QueryParam::new("quality", &quality))
                .query(&progenitor_client::QueryParam::new("tag", &tag))
                .query(&progenitor_client::QueryParam::new(
                    "unplayedCount",
                    &unplayed_count,
                ))
                .query(&progenitor_client::QueryParam::new("width", &width))
