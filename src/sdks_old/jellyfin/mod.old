        ///Sends a `POST` request to `/LiveStreams/Open`
        pub async fn send(
            self,
        ) -> Result<ResponseValue<types::LiveStreamResponse>, Error<()>> {
            let Self {
                client,
                always_burn_in_subtitle_when_transcoding,
                audio_stream_index,
                enable_direct_play,
                enable_direct_stream,
                item_id,
                max_audio_channels,
                max_streaming_bitrate,
                open_token,
                play_session_id,
                start_time_ticks,
                subtitle_stream_index,
                user_id,
                body,
            } = self;
            let always_burn_in_subtitle_when_transcoding =
                always_burn_in_subtitle_when_transcoding
                    .map_err(Error::InvalidRequest)?;
            let audio_stream_index =
                audio_stream_index.map_err(Error::InvalidRequest)?;
            let enable_direct_play =
                enable_direct_play.map_err(Error::InvalidRequest)?;
            let enable_direct_stream =
                enable_direct_stream.map_err(Error::InvalidRequest)?;
            let item_id = item_id.map_err(Error::InvalidRequest)?;
            let max_audio_channels =
                max_audio_channels.map_err(Error::InvalidRequest)?;
            let max_streaming_bitrate =
                max_streaming_bitrate.map_err(Error::InvalidRequest)?;
            let open_token = open_token.map_err(Error::InvalidRequest)?;
            let play_session_id = play_session_id.map_err(Error::InvalidRequest)?;
            let start_time_ticks = start_time_ticks.map_err(Error::InvalidRequest)?;
            let subtitle_stream_index =
                subtitle_stream_index.map_err(Error::InvalidRequest)?;
            let user_id = user_id.map_err(Error::InvalidRequest)?;
            let body = body
                .and_then(|v| {
                    types::OpenLiveStreamDto::try_from(v).map_err(|e| e.to_string())
                })
                .map_err(Error::InvalidRequest)?;
            let url = format!("{}/LiveStreams/Open", client.baseurl,);
            #[allow(unused_mut)]
            let mut request = client
                .client
                .post(url)
                .header(
                    reqwest::header::ACCEPT,
                    reqwest::header::HeaderValue::from_static("application/json"),
                )
                .json(&body)
                .query(&progenitor_client::QueryParam::new(
                    "alwaysBurnInSubtitleWhenTranscoding",
                    &always_burn_in_subtitle_when_transcoding,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "audioStreamIndex",
                    &audio_stream_index,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "enableDirectPlay",
                    &enable_direct_play,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "enableDirectStream",
                    &enable_direct_stream,
                ))
                .query(&progenitor_client::QueryParam::new("itemId", &item_id))
                .query(&progenitor_client::QueryParam::new(
                    "maxAudioChannels",
                    &max_audio_channels,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "maxStreamingBitrate",
                    &max_streaming_bitrate,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "openToken",
                    &open_token,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "playSessionId",
                    &play_session_id,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "startTimeTicks",
                    &start_time_ticks,
                ))
                .query(&progenitor_client::QueryParam::new(
                    "subtitleStreamIndex",
                    &subtitle_stream_index,
                ))
                .query(&progenitor_client::QueryParam::new("userId", &user_id))
                .build()?;
            let result = client.client.execute(request).await;
            let response = result?;
            match response.status().as_u16() {
                200u16 => ResponseValue::from_response(response).await,
                _ => Err(Error::UnexpectedResponse(response)),
            }
