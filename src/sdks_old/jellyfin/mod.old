        ///Sends a `GET` request to
        /// `/Videos/{itemId}/hls1/{playlistId}/{segmentId}.{container}`
        pub async fn send(self) -> Result<ResponseValue<ByteStream>, Error<()>> {
            let Self {
                client,
                item_id,
                playlist_id,
                segment_id,
                container,
                actual_segment_length_ticks,
                allow_audio_stream_copy,
                allow_video_stream_copy,
                always_burn_in_subtitle_when_transcoding,
                audio_bit_rate,
                audio_channels,
                audio_codec,
                audio_sample_rate,
                audio_stream_index,
                break_on_non_key_frames,
                context,
                copy_timestamps,
                cpu_core_limit,
                de_interlace,
                device_id,
                device_profile_id,
                enable_audio_vbr_encoding,
                enable_auto_stream_copy,
                enable_mpegts_m2_ts_mode,
                framerate,
                height,
                level,
                live_stream_id,
                max_audio_bit_depth,
                max_audio_channels,
                max_framerate,
                max_height,
                max_ref_frames,
                max_video_bit_depth,
                max_width,
                media_source_id,
                min_segments,
                params,
                play_session_id,
                profile,
                require_avc,
                require_non_anamorphic,
                runtime_ticks,
                segment_container,
                segment_length,
                start_time_ticks,
                static_,
                stream_options,
                subtitle_codec,
                subtitle_method,
                subtitle_stream_index,
                tag,
                transcode_reasons,
                transcoding_max_audio_channels,
                video_bit_rate,
                video_codec,
                video_stream_index,
                width,
            } = self;
            let item_id = item_id.map_err(Error::InvalidRequest)?;
            let playlist_id = playlist_id.map_err(Error::InvalidRequest)?;
            let segment_id = segment_id.map_err(Error::InvalidRequest)?;
            let container = container.map_err(Error::InvalidRequest)?;
            let actual_segment_length_ticks =
                actual_segment_length_ticks.map_err(Error::InvalidRequest)?;
            let allow_audio_stream_copy =
                allow_audio_stream_copy.map_err(Error::InvalidRequest)?;
            let allow_video_stream_copy =
                allow_video_stream_copy.map_err(Error::InvalidRequest)?;
            let always_burn_in_subtitle_when_transcoding =
                always_burn_in_subtitle_when_transcoding
