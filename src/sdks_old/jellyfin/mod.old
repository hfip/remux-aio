            let name = name.map_err(Error::InvalidRequest)?;
            let image_type = image_type.map_err(Error::InvalidRequest)?;
            let background_color = background_color.map_err(Error::InvalidRequest)?;
            let blur = blur.map_err(Error::InvalidRequest)?;
            let fill_height = fill_height.map_err(Error::InvalidRequest)?;
            let fill_width = fill_width.map_err(Error::InvalidRequest)?;
            let foreground_layer = foreground_layer.map_err(Error::InvalidRequest)?;
