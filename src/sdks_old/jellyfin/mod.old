    ///Gets an audio stream
    ///
    ///Sends a `GET` request to `/Audio/{itemId}/universal`
    ///
    ///Arguments:
    /// - `item_id`: The item id.
    /// - `audio_bit_rate`: Optional. Specify an audio bitrate to encode to,
    ///   e.g. 128000. If omitted this will be left to encoder defaults.
    /// - `audio_codec`: Optional. The audio codec to transcode to.
    /// - `break_on_non_key_frames`: Optional. Whether to break on non key
    ///   frames.
    /// - `container`: Optional. The audio container.
    /// - `device_id`: The device id of the client requesting. Used to stop
    ///   encoding processes when needed.
    /// - `enable_audio_vbr_encoding`: Optional. Whether to enable Audio
    ///   Encoding.
    /// - `enable_redirection`: Whether to enable redirection. Defaults to true.
    /// - `enable_remote_media`: Optional. Whether to enable remote media.
    /// - `max_audio_bit_depth`: Optional. The maximum audio bit depth.
    /// - `max_audio_channels`: Optional. The maximum number of audio channels.
    /// - `max_audio_sample_rate`: Optional. The maximum audio sample rate.
    /// - `max_streaming_bitrate`: Optional. The maximum streaming bitrate.
    /// - `media_source_id`: The media version id, if playing an alternate
    ///   version.
    /// - `start_time_ticks`: Optional. Specify a starting offset, in ticks. 1
    ///   tick = 10000 ms.
    /// - `transcoding_audio_channels`: Optional. The number of how many audio
    ///   channels to transcode to.
    /// - `transcoding_container`: Optional. The container to transcode to.
    /// - `transcoding_protocol`: Optional. The transcoding protocol.
    /// - `user_id`: Optional. The user id.
    ///```ignore
    /// let response = client.get_universal_audio_stream()
    ///    .item_id(item_id)
    ///    .audio_bit_rate(audio_bit_rate)
    ///    .audio_codec(audio_codec)
    ///    .break_on_non_key_frames(break_on_non_key_frames)
    ///    .container(container)
    ///    .device_id(device_id)
    ///    .enable_audio_vbr_encoding(enable_audio_vbr_encoding)
    ///    .enable_redirection(enable_redirection)
    ///    .enable_remote_media(enable_remote_media)
    ///    .max_audio_bit_depth(max_audio_bit_depth)
    ///    .max_audio_channels(max_audio_channels)
    ///    .max_audio_sample_rate(max_audio_sample_rate)
    ///    .max_streaming_bitrate(max_streaming_bitrate)
    ///    .media_source_id(media_source_id)
    ///    .start_time_ticks(start_time_ticks)
    ///    .transcoding_audio_channels(transcoding_audio_channels)
    ///    .transcoding_container(transcoding_container)
    ///    .transcoding_protocol(transcoding_protocol)
    ///    .user_id(user_id)
    ///    .send()
    ///    .await;
    /// ```
    pub fn get_universal_audio_stream(&self) -> builder::GetUniversalAudioStream {
        builder::GetUniversalAudioStream::new(self)
    }

    ///Gets an audio stream
    ///
    ///Sends a `HEAD` request to `/Audio/{itemId}/universal`
    ///
    ///Arguments:
    /// - `item_id`: The item id.
    /// - `audio_bit_rate`: Optional. Specify an audio bitrate to encode to,
    ///   e.g. 128000. If omitted this will be left to encoder defaults.
